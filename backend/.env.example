# --- Base de données ---
DATABASE_URL=postgresql+asyncpg://ppb_user:ppb_pass@localhost:5432/ppb
DATABASE_URL_SYNC=postgresql://ppb_user:ppb_pass@localhost:5432/ppb

# --- Sécurité JWT ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Bcrypt ---
BCRYPT_ROUNDS=12

# --- Signature numérique PPB (Module 3) ---
QR_SIGNING_KEY_PATH=./secrets/ppb_signing_key.pem
QR_SIGNING_ALGORITHM=ECDSA-P256

# OCR assisté (Module 4) — compte de service Google Cloud, JSON complet
# encodé en base64 sur une seule ligne (voir README pour la procédure
# d'encodage). Laissez vide tant que vous n'en avez pas créé un : le
# formulaire manuel continue de fonctionner normalement, seul le
# pré-remplissage automatique est désactivé.
GOOGLE_VISION_SERVICE_ACCOUNT_JSON_B64=
OCR_PHOTO_RETENTION_JOURS=30
# Alternative pour hébergeurs sans disque persistant (ex. Railway) : clé PEM
# encodée en base64 sur une seule ligne. Prioritaire sur QR_SIGNING_KEY_PATH.
QR_SIGNING_KEY_PEM_B64=

# --- Paiement en ligne (Module 2) — RETIRÉ pour l'instant ---
# Identifiants CinetPay pas encore disponibles. Seul le paiement
# présentiel/virement est actif. Voir le README, section « Réactiver CinetPay ».

# --- Stockage objet ---
STORAGE_BUCKET=ppb-documents-dev
STORAGE_ENDPOINT=

# --- Divers ---
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]
OFFLINE_CACHE_TTL_DAYS=60

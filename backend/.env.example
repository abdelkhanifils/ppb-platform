# --- Base de données ---
DATABASE_URL=postgresql+asyncpg://ppb_user:ppb_pass@localhost:5432/ppb
DATABASE_URL_SYNC=postgresql://ppb_user:ppb_pass@localhost:5432/ppb

# --- Sécurité JWT ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Bcrypt ---
BCRYPT_ROUNDS=12

# --- Signature numérique PPB (Module 3) ---
QR_SIGNING_KEY_PATH=./secrets/ppb_signing_key.pem
QR_SIGNING_ALGORITHM=ECDSA-P256
QR_VERIFICATION_BASE_URL=https://verify.ppb-cemac.org

# --- Paiement en ligne (Module 2) — RETIRÉ pour l'instant ---
# Identifiants CinetPay pas encore disponibles. Seul le paiement
# présentiel/virement est actif. Voir le README, section « Réactiver CinetPay ».

# --- Stockage objet ---
STORAGE_BUCKET=ppb-documents-dev
STORAGE_ENDPOINT=

# --- Divers ---
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]
OFFLINE_CACHE_TTL_DAYS=60
